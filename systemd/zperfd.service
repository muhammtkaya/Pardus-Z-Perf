# zperfd - Pardus Z-Performans bellek yoneticisi (sistem servisi)
[Unit]
Description=Pardus Z-Performans bellek yoneticisi (zperfd)
Documentation=https://example.invalid/pardus-zperf
After=multi-user.target

[Service]
Type=simple
# Gelistirme sirasinda yol build/ icinden; paketlemede /usr/sbin/zperfd olur.
ExecStart=/usr/sbin/zperfd
Restart=on-failure
RestartSec=2s
# Cekirdek arayuzlerine (sysfs, swapon) eristigi icin root gerekir.
User=root
# Servis cokerse/kapanirsa cgroup'lar temizlenir; donmus uygulama kalmamali.
# (cgroup temizligi sonraki asamada eklenecek.)

[Install]
WantedBy=multi-user.target
