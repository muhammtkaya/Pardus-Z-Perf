<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>Pardus Z-Performans</vendor>
  <vendor_url>https://github.com/muhammtkaya/Pardus-Z-Perf</vendor_url>

  <!--
    zperfd servisi root olarak calisir; ayar komutlarini (profil secimi,
    yonetimi ac/kapat) /run/zperf.sock uzerinden alir. Soket su an yerel
    kullaniciya aciktir. Ileride ayar araci, ayri bir sistem D-Bus servisini
    cagiracaksa bu yetki, etkin (local + active) oturumdaki kullaniciya
    parolasiz izin verir; ogretmen/kullanici profili degistirebilmelidir.
  -->
  <action id="org.pardus.zperf.manage">
    <description>Pardus Z-Performans ayarlarini degistir</description>
    <description xml:lang="en">Change Pardus Z-Performance settings</description>
    <message>Bellek yonetimi ayarlarini degistirmek icin yetki gerekiyor</message>
    <message xml:lang="en">Authentication is required to change memory management settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- Servisi baslatma/durdurma gibi ayricalikli islemler icin (opsiyonel). -->
  <action id="org.pardus.zperf.control">
    <description>Pardus Z-Performans servisini denetle</description>
    <description xml:lang="en">Control the Pardus Z-Performance service</description>
    <message>Servisi denetlemek icin yonetici yetkisi gerekiyor</message>
    <message xml:lang="en">Administrator authentication is required to control the service</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

</policyconfig>
